/include/ "system-conf.dtsi"

/ {
    usb_phy0: usb_phy@0 {
        compatible = "ulpi-phy";
        #phy-cells = <0>;
        reg = <0xe0002000 0x1000>;
        view-port = <0x0170>;
        drv-vbus;
    };

    backlight0: backlight {
        compatible = "gpio-backlight";
        gpios = <&gpio0 56 0>;
        default-on;
        status = "okay";
    };

    gpio-keys {
        compatible = "gpio-keys";

        up {
            label = "GPIO Key UP";
            linux,code = <103>;
            gpios = <&gpio0 57 0>;
        };

        down {
            label = "GPIO Key DOWN";
            linux,code = <108>;
            gpios = <&gpio0 58 0>;
        };
    };

    leds {
        compatible = "gpio-leds";

        heartbeat_led {
            label = "system:green:ok";
            gpios = <&gpio0 59 0>;
            default-state = "on";
            linux,default-trigger = "heartbeat";
        };
    };

    v_hdmi_tx@42040000 {
        compatible = "xlnx,v-hdmi-tx-min-1.0";
        reg = <0x42040000 0x10000>;
        clock-names = "pixel_clk";
        clocks = <&HDMI_SUB_clk_wiz_0 0>;
        reset-gpios = <&HDMI_SUB_axi_gpio_0 0 1>;
        ddc-i2c-bus = <&HDMI_SUB_axi_iic_0>;

        ports {
            #address-cells = <1>;
            #size-cells = <0>;

            port@0 {
                reg = <0>;
                hdmi_encoder: endpoint {
                    remote-endpoint = <&crtc_mixer_portHDMI_SUB_v_mix_0>;
                };
            };
        };
    };

    /*
    hdmi_connector: connector {
        compatible = "hdmi-connector";
        type = "a";

        ddc-i2c-bus = <&HDMI_SUB_axi_iic_0>;

        port {
            hdmi_encoder: endpoint {
                remote-endpoint = <&dmaengine_crtc>;
            };
        };
    };

    drm-pl-disp-drv {
        compatible = "xlnx,pl-disp";
        dmas = <&HDMI_SUB_v_frmbuf_rd_0 0>;
        dma-names = "dma0";
        xlnx,vformat = "RG24";
        // xlnx,bridge = <&HDMI_SUB_v_tc_0>;
        ports {
            #address-cells = <1>;
            #size-cells = <0>;

            port@0 {
                reg = <0>;
                dmaengine_crtc: endpoint {
                    remote-endpoint = <&hdmi_encoder>;
                };
            };
        };
    };
    */

    clk_ext_camera: camera-clock-osc24m {
        compatible = "fixed-clock";
        #clock-cells = <0>;
        clock-frequency = <24000000>;
    };
};

&usb0 {
    dr_mode = "host";
    usb-phy = <&usb_phy0>;
};

&spi0 {
    st7789v@0 {
        compatible = "jhongjingyuan,zjy133t-if05";
        reg = <0>;
        spi-max-frequency = <32000000>;
        // rotation = <180>;

        // Required GPIOs
        dc-gpios = <&gpio0 54 0>;
        reset-gpios = <&gpio0 55 0>;

        // Optional Properties
        backlight = <&backlight0>;
    };
};

&gem0 {
    phy-mode = "rgmii-id";
};

&ps7_ethernet_0_mdio {
    phy1: ethernet-phy@1 {
        reg = <1>;
        device_type = "ethernet-phy";
    };
};

&HDMI_SUB_axi_iic_0 {
    clock-frequency = <100000>;
};

&HDMI_SUB_v_frmbuf_rd_0 {
    reset-gpios = <&HDMI_SUB_axi_gpio_0 1 1>;
};

&HDMI_SUB_v_tc_0 {
    status = "disable";
};

&HDMI_SUB_v_mix_0 {
    reset-gpios = <&HDMI_SUB_axi_gpio_0 2 1>;
    xlnx,ppc = <3>;
    xlnx,video-format = <0>;
};

&xx_mix_masterHDMI_SUB_v_mix_0 {
    xlnx,vformat = "RG24";
};

&mixer_crtcHDMI_SUB_v_mix_0 {
    remote-endpoint = <&hdmi_encoder>;
};

&CAMERA_SUB_v_frmbuf_wr_0 {
    reset-gpios = <&CAMERA_SUB_axi_gpio_0 8 0>; // GPIO_ACTIVE_HIGH
};

&CAMERA_SUB_v_demosaic_0 {
    reset-gpios = <&CAMERA_SUB_axi_gpio_0 9 0>; // GPIO_ACTIVE_HIGH
};

&demosaic_port0CAMERA_SUB_v_demosaic_0 {
	demo_in: endpoint {
		remote-endpoint = <&camera_out>;
	};
};

&CAMERA_SUB_axi_iic_0 {
    camera@3c {
        compatible = "ovti,ov5640";
        reg = <0x3c>;
        clocks = <&clk_ext_camera>;
        clock-names = "xclk";
        powerdown-gpios = <&CAMERA_SUB_axi_gpio_0 0 0>; // GPIO_ACTIVE_HIGH
        reset-gpios = <&CAMERA_SUB_axi_gpio_0 1 1>; // GPIO_ACTIVE_LOW

        port {
            camera_out: endpoint {
                remote-endpoint = <&demo_in>;
                bus-width = <8>;
                data-shift = <2>; // lines 9:2 are used
                hsync-active = <0>;
                vsync-active = <0>;
                pclk-sample = <1>;
            };
        };
    };
};
